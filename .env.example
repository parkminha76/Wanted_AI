# docXray backend
# 실제 값은 Railway Variables 또는 로컬 .env에만 넣고 커밋하지 않는다.

DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=infoguard

ANTHROPIC_API_KEY=
# 로컬에서 별도 모델명을 사용 중일 때만 주석을 풀고 같은 값을 넣는다.
# ANTHROPIC_MODEL=
OPENAI_API_KEY=

# 여러 주소면 쉼표로 구분한다. 마지막 /는 쓰지 않는다.
ALLOWED_ORIGINS=http://localhost:5173
INFOGUARD_LOG_LEVEL=INFO
