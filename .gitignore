# =========================================
# INFOGUARD for Work - .gitignore
# (frontend / backend / prompts / docs 모노레포 기준)
# =========================================

# ---------- 1. 환경변수 & 시크릿 (제일 중요) ----------
# LLM API 키(OpenAI/Anthropic/Upstage), DB 접속정보 등
.env
.env.*
!.env.example
*.env
.env.local
.env.development
.env.production
*credentials*
*secret*
*.pem
*.key
*.p12
*.pfx
config/secrets*
service-account*.json
gcp-key.json

# ---------- 2. Python (백엔드 / TF-IDF 분류기 / 모델링) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 학습된 모델 / 데이터 아티팩트 (용량 크고, 민감 데이터 섞일 수 있음)
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.onnx
# HuggingFace 계열 가중치 — NER 모델을 로컬에 받으면 이 형식으로 저장된다
*.bin
*.safetensors
/data/raw/
/data/processed/
/models/*.pkl
/models/checkpoints/
*.csv
!sample_data/**/*.csv
!/prompts/**/*.csv
sample_data/*_sample.png

# ---------- 3. Node / 프론트엔드 ----------
node_modules/
dist/
build/
.next/
out/
.turbo/
.parcel-cache/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- 4. 로그 & 임시파일 ----------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
.tmp/

# ---------- 5. OS / 에디터 ----------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.iml
.history/

# ---------- 6. 배포/인프라 ----------
.vercel
.netlify
*.tfstate
*.tfstate.backup
.terraform/

# ---------- 7. 테스트/스크린샷 산출물 (mockup, PDF 렌더 결과 등) ----------
/render_output/
*.pdf
!docs/**/*.pdf
# 심사위원용 데모 샘플(계약서 PDF)은 반드시 커밋되어야 한다.
# 이 예외가 없으면 발표 당일 "샘플 4개 중 3개만 동작"하는 사고가 난다.
!sample_data/**/*.pdf
# 숨은 텍스트 테스트 문서(렌더 모드 3 / 투명도 0 / 배경색 = 글자색)도 같은 이유로
# 커밋되어야 한다. 이 예외가 없으면 hidden.py의 PDF 케이스 4개가 조용히 빠진다.
!backend/scanner/tests/**/*.pdf
playwright-report/
test-results/

# ---------- 8. 스캐너가 만드는 임시 산출물 ----------
# 업로드 원본은 저장하지 않는 것이 제품 원칙이지만, 개발 중 임시 폴더가
# 커밋되는 사고가 흔하다. 실수로도 올라가지 않게 막아둔다.
uploads/
outputs/
scratch/