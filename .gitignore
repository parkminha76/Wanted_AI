# =========================================
# INFOGUARD for Work - .gitignore
# (frontend / backend / prompts / docs 모노레포 기준)
# =========================================

# ---------- 1. 환경변수 & 시크릿 (제일 중요) ----------
# LLM API 키(OpenAI/Anthropic/Upstage), DB 접속정보 등
.env
.env.*
!.env.example
*.env
.env.local
.env.development
.env.production
*credentials*
*secret*
*.pem
*.key
*.p12
*.pfx
config/secrets*
service-account*.json
gcp-key.json

# ---------- 2. Python (백엔드 / TF-IDF 분류기 / 모델링) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 학습된 모델 / 데이터 아티팩트 (용량 크고, 민감 데이터 섞일 수 있음)
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.onnx
/data/raw/
/data/processed/
/models/*.pkl
/models/checkpoints/
*.csv
!sample_data/**/*.csv
!/prompts/**/*.csv
sample_data/*_sample.png

# ---------- 3. Node / 프론트엔드 ----------
node_modules/
dist/
build/
.next/
out/
.turbo/
.parcel-cache/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- 4. 로그 & 임시파일 ----------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
.tmp/

# ---------- 5. OS / 에디터 ----------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.iml
.history/

# ---------- 6. 배포/인프라 ----------
.vercel
.netlify
*.tfstate
*.tfstate.backup
.terraform/

# ---------- 7. 테스트/스크린샷 산출물 (mockup, PDF 렌더 결과 등) ----------
/render_output/
*.pdf
!docs/**/*.pdf
playwright-report/
test-results/